# npm run setup creates credentials only when .env is absent.
# For an existing partial file, fill only missing entries; keep all credentials.
POSTGRES_DB=velio
POSTGRES_USER=velio_migration
POSTGRES_PASSWORD=
RUNTIME_DB_USER=velio_runtime
RUNTIME_DB_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Optional local tooling target, e.g. http://10.0.2.2:3000 for Android:
# API_BASE_URL=http://127.0.0.1:3000
# Opt in to LAN development only when needed:
# WEB_HOST=0.0.0.0
# New activities only; persisted assignments never change when these change.
INVITE_EXPERIMENT_VERSION=1
INVITE_TREATMENT_PERCENT=50
# Disables new creation only; ordinary booking remains available.
# Future issued-invite claim routes are intended to remain independent of this switch.
INVITE_CREATION_ENABLED=true
